      ],
      "schema": "biz_a",
      "tables": [
        "inventory",
        "product"
      ],
      "sql": "SELECT i.sku, p.name AS product_name, p.category, i.warehouse, i.qty, i.updated_at FROM biz_a.inventory i JOIN biz_a.product p ON p.id = i.product_id WHERE i.sku ILIKE %(sku_like)s ORDER BY i.qty DESC LIMIT %(limit)s",
      "params": [
