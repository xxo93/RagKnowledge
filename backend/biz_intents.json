  "intents": [
    {
      "intent_id": "order_by_customer",
      "title": "按客户查订单",
      "examples": [
        "查一下客户张三的订单",
        "张三最近买了什么",
        "客户李四过去90天的订单金额"
      ],
      "keywords": [
        "订单",
        "买了",
        "下单",
        "消费"
      ],
      "schema": "biz_a",
      "tables": [
        "customer",
        "orders",
        "product"
      ],
      "sql": "SELECT o.order_no, c.name AS customer_name, c.phone AS customer_phone, p.name AS product_name, o.qty, o.amount, o.status, o.created_at FROM biz_a.orders o JOIN biz_a.customer c ON c.id = o.customer_id JOIN biz_a.product p ON p.id = o.product_id WHERE c.name = %(customer_name)s AND o.created_at >= (CURRENT_DATE - %(since_days)s::int) ORDER BY o.created_at DESC LIMIT %(limit)s",
      "params": [
        {
          "name": "customer_name",
          "type": "string",
          "required": true,
          "min_length": 1,
          "max_length": 20,
          "example": "张三"
        },
        {
          "name": "since_days",
          "type": "number",
          "required": false,
          "min": 1,
          "max": 365,
          "default": 90,
          "example": 90
        }
      ],
      "allowed_roles": [
        "admin"
      ],
      "max_rows": 100,
      "columns": [
        {
          "key": "order_no",
          "title": "订单号"
        },
        {
          "key": "customer_name",
          "title": "客户",
          "mask": "name"
        },
        {
          "key": "customer_phone",
          "title": "手机号",
          "mask": "phone"
        },
        {
          "key": "product_name",
          "title": "商品"
        },
        {
          "key": "qty",
          "title": "数量"
        },
        {
          "key": "amount",
          "title": "金额"
        },
        {
          "key": "status",
          "title": "状态"
        },
        {
          "key": "created_at",
          "title": "下单时间",
          "type": "datetime"
        }
      ]
    },
    {
      "intent_id": "inventory_by_sku",
      "title": "按 SKU 查库存",
      "examples": [
        "查一下 SKU P001 的库存",
        "P003 各仓库还有多少库存",
