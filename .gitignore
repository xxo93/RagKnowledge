# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/

# ---- Node / 前端 ----
node_modules/
dist/
.vite/

# ---- 环境变量与密钥（真实密钥只存本地 .env，仓库只提交 .env.example）----
.env
.env.local
*.pem
*.key

# ---- 本地上传文档与导出（不入库；保留 data/uploads/ 目录占位）----
data/uploads/*
!data/uploads/.gitkeep
data/exports/
*.log

# ---- 编辑器 / IDE ----
.idea/
.vscode/
