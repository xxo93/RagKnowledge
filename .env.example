# ============================================================================
# RagKnowledge 环境变量样例：复制为项目根 .env 后填入真实值；.env 不入库（见 .gitignore）
# 后端在 backend/ 目录启动时自动读取上级根目录 .env（config.py env_file=("../.env",".env")）
# ============================================================================

# ---------- 服务 ----------
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# ---------- PostgreSQL + pgvector（单库 rag_agent） ----------
# 格式：postgresql://用户:密码@主机:端口/库名
DB_DSN=postgresql://postgres:postgres@127.0.0.1:5432/rag_agent
DB_POOL_MIN=2
DB_POOL_MAX=10

# ---------- LLM（OpenAI 兼容协议，默认 DeepSeek；可切豆包/通义/OpenAI） ----------
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
LLM_MODEL=deepseek-chat
LLM_TIMEOUT=60

# ---------- Embedding（provider: local / api / ollama；维度必须与表列一致！） ----------
# 当前选型：方案② api 托管 = 阿里云百炼 text-embedding-v3（默认 1024 维，匹配 vector(1024)，无需改表）
EMBEDDING_PROVIDER=api
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIM=1024
# v3 OpenAI 兼容模式单次最多 10 行；代码内再取 min(配置,10)，勿填过大
EMBEDDING_BATCH_SIZE=10
# 公共兼容端点；也可换工作空间专属 https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 百炼 API Key（控制台获取；等价环境变量 DASHSCOPE_API_KEY）。未填时入库/检索向量化返回 50003
EMBEDDING_API_KEY=

# ---------- 文本切片 ----------
CHUNK_SIZE=500
CHUNK_OVERLAP=100

# ---------- 向量检索 ----------
TOP_K=5
RETRIEVAL_MIN_SCORE=0.0
RERANK_ENABLED=false
RERANK_MODEL=BAAI/bge-reranker-v2-m3
HNSW_EF_SEARCH=40
# pgvector 0.8+ 枚举：off / relaxed_order / strict_order；0.7.x 无此项可填 off
HNSW_ITERATIVE_SCAN=relaxed_order
HNSW_MAX_SCAN_TUPLES=20000

# ---------- Agent ----------
HISTORY_ROUNDS=5
MAX_TOOL_ROUNDS=3

# ---------- 上传 ----------
UPLOAD_MAX_MB=10
UPLOAD_DIR_NAME=data/uploads
